# ─────────────────────────────────────────────────────────────────────────
# PAWS & PANIC — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your real values.
# The `.env` file is gitignored — never commit real credentials.
#
# VITE_ prefixed variables are exposed to the browser client.
# Non-VITE_ variables are backend-only (for CI/CD or backend services).
# ─────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════
# AGS (AccelByte Gaming Services) — Frontend Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Base URL of your AGS environment (no trailing slash)
# Example: https://demo.accelbyte.io or https://abyuditest-pawsandpanic.prod.gamingservices.accelbyte.io
VITE_AGS_BASE_URL=https://demo.accelbyte.io

# The namespace (game/publisher namespace) your title lives in
VITE_AGS_NAMESPACE=your-namespace

# OAuth client ID (public client — confidential clients need a backend)
VITE_AGS_CLIENT_ID=your-client-id

# OAuth redirect URI registered on the client (must match exactly)
# For local dev with Vite this is typically the dev server root.
# For production (GitHub Pages), use the full GitHub Pages URL.
# Example dev: http://localhost:5173
# Example prod: https://yudi-ab.github.io/paws-and-panic/
VITE_AGS_REDIRECT_URI=http://localhost:5173

# Match pool names configured in the AGS Admin Portal (Matchmaking v2).
# The game passes a duration (30s or 60s); map each to a corresponding pool.
VITE_AGS_MATCH_POOL_30=paws-panic-30s
VITE_AGS_MATCH_POOL_60=paws-panic-60s
