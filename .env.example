# ─────────────────────────────────────────────────────────────────────────
# PAWS & PANIC — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your real values.
# The `.env` file is gitignored — never commit real credentials.
#
# VITE_ prefixed variables are exposed to the browser client.
# Non-VITE_ variables are backend-only (for CI/CD or backend services).
# ─────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════
# AGS (AccelByte Gaming Services) — Frontend Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Base URL of your AGS environment (no trailing slash)
# Example: https://demo.accelbyte.io or https://abyuditest-pawsandpanic.prod.gamingservices.accelbyte.io
VITE_AGS_BASE_URL=https://demo.accelbyte.io

# The namespace (game/publisher namespace) your title lives in
VITE_AGS_NAMESPACE=your-namespace

# ─────────────────────────────────────────────────────────────────────────
# DEV / STAGING CLIENT (used for local development and staging)
# ─────────────────────────────────────────────────────────────────────────
# OAuth client ID (public client — confidential clients need a backend)
VITE_AGS_CLIENT_ID=your-dev-client-id

# OAuth redirect URI for dev/staging (must match exactly in AGS admin)
# Example: http://localhost:5173 or https://staging.example.com/paws-and-panic/
VITE_AGS_REDIRECT_URI=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────
# PRODUCTION CLIENT (used for GitHub Pages / production deployments)
# ─────────────────────────────────────────────────────────────────────────
# Production OAuth client ID (separate credential for prod safety)
VITE_AGS_PROD_CLIENT_ID=your-prod-client-id

# Production redirect URI (must match exactly in AGS admin)
# Example: https://yudi-ab.github.io/paws-and-panic/
VITE_AGS_PROD_REDIRECT_URI=https://yudi-ab.github.io/paws-and-panic/

# Match pool names configured in the AGS Admin Portal (Matchmaking v2).
# The game passes a duration (30s or 60s); map each to a corresponding pool.
VITE_AGS_MATCH_POOL_30=paws-panic-30s
VITE_AGS_MATCH_POOL_60=paws-panic-60s

# AGS Stats & Leaderboards
VITE_AGS_STAT_LONGEST_METERS=longest-run-meters
VITE_AGS_STAT_LONGEST_SECONDS=longest-run-seconds
VITE_AGS_STAT_LOWEST_PANIC=lowest-panic
VITE_AGS_STAT_TOTAL_WINS=total-wins
VITE_AGS_STAT_TOTAL_LOSSES=total-losses
VITE_AGS_LEADERBOARD_METERS=longest-run-meters
VITE_AGS_LEADERBOARD_SECONDS=longest-run-seconds
VITE_AGS_LEADERBOARD_PANIC=lowest-panic
